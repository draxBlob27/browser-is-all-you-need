FROM buildpack-deps:jammy

ARG AIDER_COMMIT
ARG POLYGLOT_COMMIT

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 python3-dev python3-pip python3-venv \
    git g++ gcc cmake make libboost-all-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN test -n "$AIDER_COMMIT" && test -n "$POLYGLOT_COMMIT" \
    && git clone https://github.com/Aider-AI/aider.git /opt/aider \
    && git -C /opt/aider checkout --detach "$AIDER_COMMIT" \
    && test "$(git -C /opt/aider rev-parse HEAD)" = "$AIDER_COMMIT" \
    && mkdir -p /opt/aider/tmp.benchmarks \
    && git clone https://github.com/Aider-AI/polyglot-benchmark.git \
       /opt/aider/tmp.benchmarks/polyglot-benchmark \
    && git -C /opt/aider/tmp.benchmarks/polyglot-benchmark checkout --detach "$POLYGLOT_COMMIT" \
    && test "$(git -C /opt/aider/tmp.benchmarks/polyglot-benchmark rev-parse HEAD)" = "$POLYGLOT_COMMIT"

RUN python3 -m pip install --no-cache-dir --upgrade pip uv \
    && uv pip install --system --no-cache-dir -e '/opt/aider[dev]'

COPY Dockerfile.aider /opt/w8/Dockerfile.aider
WORKDIR /opt/aider
ENV AIDER_DOCKER=1 PYTHONUNBUFFERED=1
